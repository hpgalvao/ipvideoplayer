# Normaliza finais de linha; scripts do Windows usam CRLF.
* text=auto

*.js   text eol=lf
*.jsx  text eol=lf
*.json text eol=lf
*.css  text eol=lf
*.md   text eol=lf

*.cmd  text eol=crlf
*.bat  text eol=crlf

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.sqlite binary
