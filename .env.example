NODE_ENV=production
PORT=8787
IPTV_BASE_URL=http://seu-servidor-iptv
IPTV_USERNAME=seu-usuario
IPTV_PASSWORD=sua-senha
JWT_SECRET=troque-por-um-valor-longo-e-aleatorio

# Limite de catalogos por usuario (pode ser sobrescrito por usuario via catalog_limit no banco).
MAX_CATALOGS_PER_USER=5

# Caminho do arquivo SQLite (padrao: ./data/catalog.sqlite).
# Use caminho absoluto para maior seguranca (ex.: /opt/iptv/data/catalog.sqlite).
# IPTV_DB_PATH=/caminho/seguro/fora/da/pasta/publica

# Origem(is) permitida(s) para CORS, separadas por virgula. Por padrao, apenas
# as origens de desenvolvimento do Vite e requisicoes same-origin sao aceitas.
# CORS_ORIGINS=https://iptv.seudominio.com

# Habilite se estiver atras de um proxy reverso confiavel (ex.: Traefik/Nginx),
# para que req.ip e o protocolo (HTTPS) sejam detectados corretamente.
# TRUST_PROXY=1

# Descomente para desativar os cabecalhos de seguranca (CSP/HSTS/etc.) em caso de emergencia.
# SECURITY_HEADERS_DISABLED=1

# Fonte alternativa opcional (tentada antes das demais). Aceita link xc://, get.php, xmltv.php
# ou URL M3U/M3U8. Ex.: IPTV_SOURCE=xc://usuario:senha@host/streaming=ts
# IPTV_SOURCE=

# Servidores DNS custom para o backend (evita ENOTFOUND quando o DNS da operadora falha).
# Separadores aceitos: virgula, espaco ou ponto-e-virgula.
# Comente ou deixe vazio para usar o DNS padrao do sistema.
# O resolvedor custom tem timeout e cai para o DNS do sistema se nao responder.
IPTV_DNS_SERVERS=162.159.38.218,172.64.33.126,185.49.71.100,46.165.236.165

# Ajustes opcionais de tempo (ms).
# IPTV_DNS_TIMEOUT_MS=5000
# IPTV_FETCH_TIMEOUT_MS=180000
# IPTV_CATALOG_TIMEOUT_MS=180000
# IPTV_CATALOG_TOTAL_TIMEOUT_MS=600000
