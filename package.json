    "dotenv": "^17.4.2",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.3",
    "node-fetch": "^3.3.2",
    "sql.js": "^1.14.1"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
