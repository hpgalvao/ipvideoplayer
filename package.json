{
  "name": "iptv",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Aplicativo IPTV pessoal com proxy Xtream Codes e interface estilo streaming.",
  "main": "server/index.js",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
